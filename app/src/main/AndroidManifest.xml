<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <supports-screens
        android:xlargeScreens="true"
        android:largeScreens="true"
        android:smallScreens="true"
        android:anyDensity="true"
        tools:targetApi="gingerbread" />

    <application
        android:name=".Application"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <activity
            android:name=".Units"
            android:theme="@style/AppTheme"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
            </intent-filter>

            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable" />

        </activity>

        <activity
            android:name=".UnitListActivity"
            android:theme="@style/UnitListTheme"
            android:exported="false"
            android:launchMode="singleTop">

            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
            </intent-filter>

            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable" />

        </activity>

        <activity
            android:name=".UnitDetails"
            android:theme="@style/UnitDetailsTheme"
            android:exported="false" />

        <provider
            android:name=".UnitsContentProvider"
            android:authorities="de.buttercookie.units"
            android:exported="false" />

    </application>

</manifest> 
